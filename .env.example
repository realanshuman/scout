# ── Core ────────────────────────────────────────────────────────────
NODE_ENV=development
API_PORT=4000
# Public URL of the API (used for payment webhooks / WhatsApp callbacks)
API_PUBLIC_URL=http://localhost:4000
# Public URL of the dashboard
WEB_PUBLIC_URL=http://localhost:3000

# ── Auth (Better Auth, used by the web dashboard) ──────────────────
# A long random string. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me
# Public base URL of the web app (where /api/auth lives)
BETTER_AUTH_URL=http://localhost:3000
# Postgres connection string (your Neon DB, the pooled connection string).
# Powers auth + all app data. Gates the dashboard: when set, the dashboard
# requires sign-in AND an active subscription.
DATABASE_URL=postgresql://user:password@host/db?sslmode=require
# Optional: Better Auth hosted add-on (admin dashboard + Sentinel bot
# protection). Leave unset to run core auth only. Keep this SECRET.
BETTER_AUTH_API_KEY=ba_...
# Optional: enables the one-time demo seed at /api/seed-demo?token=THIS.
# Set to any random value to seed a demo account, then unset if you like.
SEED_TOKEN=

# ── OpenAI ──────────────────────────────────────────────────────────
OPENAI_API_KEY=sk-...
# Default chat/agent model (Responses API)
OPENAI_MODEL=gpt-5.5
# Cheaper model for extraction / classification steps
OPENAI_FAST_MODEL=gpt-5.5-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ── Supabase ────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# ── WhatsApp via Twilio (used by the web app on Vercel) ────────────
# From the Twilio Console dashboard.
TWILIO_ACCOUNT_SID=AC...
TWILIO_AUTH_TOKEN=...
# The WhatsApp sender. Sandbox is +14155238886; once approved, your own number.
TWILIO_WHATSAPP_FROM=+14155238886
# Set to "true" ONLY for local testing without Twilio's signature (never in prod).
TWILIO_SKIP_SIGNATURE_CHECK=

# ── WhatsApp (Meta Business Cloud API — legacy, used by apps/api) ───
WHATSAPP_PHONE_NUMBER_ID=123456789
WHATSAPP_ACCESS_TOKEN=EAAG...
# Any random string; must match what you enter in the Meta webhook config
WHATSAPP_VERIFY_TOKEN=scout-verify-token
# ── "Message Scout" buttons (public, baked in at build time) ───────
# The number every Message Scout button opens. Use the Twilio WhatsApp sandbox
# number while testing, or your approved sender in production.
NEXT_PUBLIC_WHATSAPP_NUMBER=14155238886
# Only while on the Twilio sandbox: your join phrase, e.g. "join happy-tiger".
# It gets pre-filled so a first-time visitor connects with one tap. Leave empty
# once you have a production sender. Changing these needs a redeploy.
NEXT_PUBLIC_WHATSAPP_JOIN_CODE=

# ── Search / scraping ──────────────────────────────────────────────
# Tavily powers live investor discovery in the dashboard ("Find investors").
# Needed by the WEB app too — set this in Vercel, not just on the API.
TAVILY_API_KEY=tvly-...
FIRECRAWL_API_KEY=fc-...
# Model used for investor discovery in the web app (optional).
SCOUT_DISCOVERY_MODEL=gpt-4o-mini

# ── Payments (Dodo Payments — merchant of record) ──────────────────
DODO_PAYMENTS_API_KEY=...
# Webhook signing key from Dashboard → Webhooks (whsec_...)
DODO_PAYMENTS_WEBHOOK_KEY=whsec_...
# One-time product for the full investor report (₹999 / $29)
DODO_PAYMENTS_PRODUCT_ID=pdt_...
# test_mode (default) or live_mode
DODO_PAYMENTS_ENVIRONMENT=test_mode

# ── Queue (optional — falls back to in-process jobs when unset) ────
REDIS_URL=redis://localhost:6379
